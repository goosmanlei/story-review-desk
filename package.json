{
  "name": "story-review-desk",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev web",
    "build": "next build web --webpack",
    "start": "node web/.next/standalone/web/server.js",
    "project:create": "node tools/project.mjs create",
    "review": "node scripts/review.mjs",
    "deploy": "node tools/deploy.mjs",
    "process": "node tools/process.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/workspace-navigation.ui.mjs",
    "test:types": "tsc --project web/tsconfig.json --noEmit --incremental false",
    "cleanup:finish": "node tools/process.mjs finish",
    "cleanup:check": "node tools/process.mjs check",
    "cleanup:complete": "node tools/cleanup.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "pg": "^8.16.3",
    "pinyin-pro": "3.29.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "markdown-it": "15.0.2",
    "typescript": "5.9.3"
  },
  "type": "module",
  "bin": {
    "review": "scripts/review.mjs"
  }
}
