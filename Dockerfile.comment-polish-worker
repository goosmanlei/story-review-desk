FROM node:22-bookworm-slim
ARG REVIEW_SOFTWARE_COMMIT=UNVERSIONED
LABEL org.opencontainers.image.revision=$REVIEW_SOFTWARE_COMMIT
ENV REVIEW_SOFTWARE_COMMIT=$REVIEW_SOFTWARE_COMMIT
ENV REVIEW_SQLITE_OWNER=CONTAINER
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY workers/ ./workers/
COPY host/instance-runtime/ ./host/instance-runtime/
ENV NODE_ENV=production
ENV REVIEW_INSTANCE_ROOT=/instance
ENV COMMENT_POLISH_HOST=0.0.0.0
ENV COMMENT_POLISH_PORT=8787
EXPOSE 8787
USER node
CMD ["node", "workers/comment-polish-server.mjs"]
