export function runMaterialUsageIteration(input:{repository:InstanceRepository;api:MaterialUsageApi}):Promise<{processed:false}|({processed:true;status:'SUCCEEDED'}&MaterialUsageResult)|{processed:true;jobId:string;status:string}>;
