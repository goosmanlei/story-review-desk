import type {InstanceReadUnit,InstanceUnit,InstanceRepository} from './index.mjs';
import type {projectOperationalState,hashStableFile,safeGeneratedPath} from '../../app/api/v8/_store';
import type {ReviewSpec} from './configuration-model.mjs';
import type {MaterialUsageTarget,MaterialUsageContent,MaterialUsageRequirementBasis,MaterialUsageSource,MaterialUsageBody} from './material-usage-model.mjs';
export const MATERIAL_USAGE_NS:{drafts:string;jobs:string;requests:string};
export type MaterialUsageApi={projectOperationalState:typeof projectOperationalState;safeGeneratedPath?:typeof safeGeneratedPath;hashStableFile?:typeof hashStableFile};
export type MaterialUsageDraft=MaterialUsageTarget&{usageId:string;baseReleaseId:string;basisHash:string;content:MaterialUsageContent;revisionId:string};
export type MaterialUsageResult=MaterialUsageTarget&{releaseId:string;usageId:string;usageRevisionId:string;eventId:string;action:MaterialUsageContent['decision']['action'];sourceRef:string;sourceRevisionId:string;sourceSha256:string;modelCalls:0;formalAdoptionPerformed:false;formalUsageReviewPerformed:true};
export type MaterialUsageWorkspace=MaterialUsageTarget&{protocol:'MATERIAL_USAGE_V1';supported:true;readOnly:boolean;usageId:string;releaseId:string;basisHash:string;requirement:MaterialUsageRequirementBasis;sourceVersion:Omit<MaterialUsageSource,'path'|'media'|'adoption'>&{path:string|null;media:MaterialUsageSource['media']|null;adoption:MaterialUsageSource['adoption']|null};sourceAdoption:Record<string,unknown>|null;reviewSpec:ReviewSpec;head:Record<string,unknown>|null;draftHeadRevisionId:string|null;draft:MaterialUsageDraft|null;staleDraft:(MaterialUsageDraft&{reason:string})|null;blockers:string[];jobs:Array<{jobId:string;requestId:string;status:string;error?:string;result?:MaterialUsageResult}>};
export type MaterialUsagePreview=MaterialUsageTarget&{draftRevisionId:string};
export type MaterialUsageSelection={protocol:'MATERIAL_USAGE_V1';supported:true;readOnly:boolean;requirementId:string;releaseId:string;requirement:MaterialUsageRequirementBasis;reviewSpec:ReviewSpec;eligibleSources:Array<{familyId:string;versionId:string;sha256:string;title:string;sameEntity:boolean;mediaToken?:string;mediaUrl?:string}>;blockers:string[]};
export function listMaterialUsageSources(tx:InstanceReadUnit,input:{requirementId:string},options:{api:MaterialUsageApi}):Promise<MaterialUsageSelection>;
export type MaterialUsageEnqueue=MaterialUsagePreview&{previewHash:string;requestId:string};
export function getMaterialUsageWorkspace(tx:InstanceReadUnit,input:MaterialUsageTarget,options:{api:MaterialUsageApi}):Promise<MaterialUsageWorkspace>;
export function saveMaterialUsageDraft(tx:InstanceUnit,input:MaterialUsageTarget&{expectedReleaseId:string;expectedBasisHash:string;expectedDraftRevisionId:string|null;content:unknown},options:{api:MaterialUsageApi}):Promise<{revisionId:string;modelCalls:0;formalAdoptionPerformed:false;formalUsageReviewPerformed:false}>;
